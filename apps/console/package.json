{
  "name": "yunyue-cloud-console",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "cf workers types --include-runtime=false && tsc --noEmit && vite build",
    "typecheck": "cf workers types --include-runtime=false && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "cf workers types",
    "deploy:check": "npm run build && cf deploy --prebuilt --dry-run",
    "build:music": "cd music-worker && cf build"
  },
  "engines": {
    "node": "^22.23.0 || >=24.22.0"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "lucide-react": "^0.556.0",
    "marked": "^18.0.3",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@cloudflare/workers-types": "5.20261102.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "cf": "1.0.0-beta.26",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "miniflare": "^5.20261101.0-beta",
    "typescript": "^5.9.2",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
