{
  "version": 2,
  "functions": {
    "api/password.mjs": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/music.mjs": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "{generated/**,node_modules/@jitl/quickjs-*/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "buildCommand": "npm run build"
}
